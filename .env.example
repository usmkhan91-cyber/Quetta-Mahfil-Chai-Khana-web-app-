# =============================================================================
# SERVER-ONLY SECRETS (Never prefix with VITE_)
# =============================================================================
# GEMINI_API_KEY: Primary AI engine for Saki agent (Gemini 3.8 Flash)
GEMINI_API_KEY=

# GROQ_API_KEY: Fallback AI model provider (DeepSeek R1)
GROQ_API_KEY=

# NOTE: Administrative routes require a verified Firebase Auth ID Token (Bearer <token>).
# SuperAdmin and Admin roles are enforced server-side via Firebase Admin SDK and Firestore /admins RBAC.

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =============================================================================
# CLIENT ENVIRONMENT CONFIGURATION (Safe for browser bundle)
# =============================================================================
VITE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
